<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- chore/boot-3.5-upgrade: minor-line bump 3.3.13 -> 3.5.16 (still the frozen 3.x line,
         CLAUDE.md "Stack"; 3.5.16 is the final OSS release of the 3.5 line, OSS EOL 2026-06-30,
         no Boot 3.6 exists, next is the 4.x major, out of this session's scope). Real fix for
         CVE-2026-41716 (spring-data-commons, HIGH): the 3.3.x line is itself EOL for this CVE, no
         patch exists on 3.3.x/3.4.x, only 3.5.12+/4.0.6+. See docs/STATE.md for the full record. -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>sy.khatm</groupId>
  <artifactId>khatm-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>khatm-platform</name>
  <description>Khatm — enterprise digital document trust fabric (backend platform)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- chore/boot-3.5-upgrade: 1.2.4 -> 1.4.1, the spring-modulith line compiled against Boot 3.5
         per its own Spring Boot compatibility matrix (docs.spring.io/spring-modulith/reference). -->
    <spring-modulith.version>1.4.1</spring-modulith.version>
    <spotless.version>2.43.0</spotless.version>
    <google-java-format.version>1.22.0</google-java-format.version>
    <checkstyle.version>3.3.1</checkstyle.version>
    <checkstyle-tool.version>10.12.4</checkstyle-tool.version>
    <!-- KH-0.3.2: patch-level overrides of spring-boot-starter-parent's managed versions, to clear
         CRITICAL/HIGH CVEs the Trivy fs gate found with a fixed version in the SAME minor line
         (a true "bump the patch," not a minor/major upgrade). See docs/STATE.md for the full list
         and which CVEs could NOT be cleared this way. -->
    <!-- KH-1.1.3-BE PR #29 CI (2026-07-22): CVE-2026-54291, HIGH — SCRAM-SHA-256-PLUS downgrade
         MITM bypass. Patch-level bump, same minor line (42.7.x). -->
    <postgresql.version>42.7.12</postgresql.version>
    <tomcat.version>10.1.55</tomcat.version>
    <!-- chore/public-base-url PR #31 CI (2026-07-23): CVE-2026-59901, HIGH — netty-codec Bzip2Decoder
         infinite loop in its RLE state machine (event-loop thread DoS). Patch-level bump, same
         minor line (4.1.13x.Final). -->
    <netty.version>4.1.136.Final</netty.version>
    <!-- KH-1.1.3-BE PR #29 CI (2026-07-22): GHSA-r7wm-3cxj-wff9, HIGH — jackson-core async parser
         maxNumberLength bypass (incomplete prior fix). 2.18.8 is the lowest fixed version Trivy
         reports; overriding jackson-bom.version (Boot's own recognized property for the whole
         Jackson BOM import) rather than jackson-core alone keeps every jackson-* artifact on one
         matching release, the same whole-line-together rationale spring-security.version above
         already established. -->
    <jackson-bom.version>2.18.8</jackson-bom.version>
    <!-- CVE-2026-22732 follow-up (flagged in docs/STATE.md "Open decisions / blockers" at
         KH-0.3-closure): tried overriding spring-security-web ALONE first (dependencyManagement
         entry, everything else left at the Boot BOM's 6.3.10) per the session brief's preferred
         path. Confirmed broken empirically, not assumed: spring-security-web 6.5.9 references
         org.springframework.security.core.annotation.SecurityAnnotationScanners, a class that
         only exists in spring-security-core 6.4+ — with core still at 6.3.10, every
         @SpringBootTest context hitting requestMappingHandlerAdapter failed with
         NoClassDefFoundError. Falling back to the whole line, exactly as the brief's contingency
         says: override spring-security.version itself so config/core/crypto/test/web all move to
         the same matching 6.5.x release together. -->
    <spring-security.version>6.5.9</spring-security.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spring Boot starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      KH-0.6b (spec FS-0.6b §7): Spring Security filter chain (session auth, API-key filter,
      method-security scope gates) + Spring Session's Redis-backed HttpSession store (D1 — server-
      side console sessions, cookie KHATM_SESSION). Redis is already a runtime dependency (ADR-09
      Streams); this only adds the session-store integration on top of it.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-data-redis</artifactId>
    </dependency>

    <!-- Spring Modulith — structural enforcement + event infrastructure -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jdbc</artifactId>
    </dependency>
    <!--
      ADR-09 worker skeleton: the custom Redis Streams externalizer (shared/events) instantiates
      DelegatingEventExternalizer directly. That class lives in spring-modulith-events-core, which
      spring-modulith-starter-jdbc pulls in at RUNTIME scope only — so it is absent at compile time.
      Promoting it to the default (compile) scope here makes the externalization SPI visible to our
      code. Version managed by the spring-modulith BOM (no official spring-modulith-events-redis
      exists for 1.2.x, hence the custom transport — see RedisStreamsExternalizationConfig).
    -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-core</artifactId>
    </dependency>

    <!-- Database -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- JOSE / JWT signing (ES256) -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.40</version>
    </dependency>

    <!--
      KH-0.5: PKCS#12 KeyStore.setKeyEntry always requires a certificate chain alongside a
      private key, even though we only ever use the key pair via standard JCA/Nimbus (ES256
      signing/verification never touches BouncyCastle). Used solely to mint a minimal
      self-signed X.509 certificate to satisfy that container-format requirement — see
      SoftKeyProvider.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>

    <!--
      KH-0.6b (spec FS-0.6b D4): Spring Security's Argon2PasswordEncoder delegates to BouncyCastle's
      Argon2BytesGenerator (org.bouncycastle.crypto.generators, in bcprov). bcpkix above already
      pulls in bcprov-jdk18on transitively, but pinning it explicitly at the same version avoids
      depending on that transitive resolution staying stable.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>

    <!--
      KH-0.4 (spec FS-0.4 D4): SD-JWT disclosure/digest construction only (SDObjectBuilder,
      Disclosure, SDJWT). Confirmed before adopting: this library never touches signing or key
      material — it hands us the payload Map to sign, and we sign it exclusively through
      KeySigner (Nimbus), exactly as before. Its own pom pulls in Gson (own JSON handling) and
      Nimbus at test-scope only, so nothing here conflicts with our existing Jackson/Nimbus use.
    -->
    <dependency>
      <groupId>com.authlete</groupId>
      <artifactId>sd-jwt</artifactId>
      <version>1.9</version>
    </dependency>

    <!--
      KH-0.4 introduced the "-api" artifact for OpenAPI annotations + JSON generation
      (/v3/api-docs) only, deliberately excluding Swagger UI (no auth existed yet). Now that
      KH-0.6b's auth layer is live, this session swaps to "-webmvc-ui", which pulls in
      "-webmvc-api" transitively and adds /swagger-ui.html — one concept, one artifact, per
      CLAUDE.md work rule 4. Swagger UI itself is exposed only when profile local/dev is active
      (see rbac.security.SecurityConfig); the JSON contract (/v3/api-docs) is always generated,
      unauthenticated exposure is what's gated.

      Version pinned to 2.6.0 for Boot 3.3.13's Framework 6.1 line (see git history for the full
      empirical story). chore/boot-3.5-upgrade: bumped to 2.8.6 (V4 — required, not optional:
      2.6.0's compiled-in ControllerAdviceBean(Object) call no longer exists on Framework 6.2.19,
      which Boot 3.5.16 manages — /v3/api-docs generation threw NoSuchMethodError at request time
      under mvn verify, confirmed empirically). 2.8.x is springdoc's own minimum line for Boot
      3.5.x per its compatibility matrix. Its own breaking change, also confirmed empirically:
      2.8.0+ defaults api-docs generation to OpenAPI 3.1 instead of 3.0 — pinned back to 3.0 via
      springdoc.api-docs.version below (application.yml) purely to keep this session's contract
      diff cosmetic (Phase 2d gate, veto V2); a real 3.1 migration is a deliberate future decision
      for whoever owns the console/wallet contract, not a side effect of a dependency bump.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.6</version>
    </dependency>

    <!--
      KH-0.6a (spec FS-0.6a D6): structured JSON logging in every profile except 'local'.
      Version 8.0 rather than the newer 9.0 — 8.0's own declared logback-classic baseline
      (1.5.6) sits safely under Spring Boot 3.3.4's managed version (1.5.8); 9.0 wants 1.5.20,
      which we don't have. logback-classic itself comes from spring-boot-starter (already a
      transitive dependency via spring-boot-starter-web); this only adds the JSON encoder.
    -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      KH-2.3b (spec FS-2.3 D5/D6): Vault dev-mode container for VaultTransitProvider's own test
      suite (re-running the 2.3a acceptance surface against a real Vault transit backend, plus the
      JOSE-marshaling test vector and the fail-closed-on-unreachable path). Version managed by the
      testcontainers-bom import above. Production code talks to Vault over its plain HTTP API via
      Spring's own RestClient (already transitively present via spring-boot-starter-web) — no
      Vault client SDK dependency needed at compile/runtime scope, keeping the app's own
      classpath/attack-surface unchanged.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>vault</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot packaging -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Spotless — enforces google-java-format on every .java file.
        Run `mvn spotless:apply` to auto-format; `mvn spotless:check` to verify.
        Bound to validate phase so it fails fast before compilation.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Checkstyle — structural rules (naming, Javadoc on API surface,
        forbidden patterns). Formatting is handled by Spotless above.
        Bound to validate phase alongside Spotless.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle-tool.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <sourceDirectories>
            <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
          </sourceDirectories>
          <testSourceDirectories>
            <testSourceDirectory>${project.build.testSourceDirectory}</testSourceDirectory>
          </testSourceDirectories>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
