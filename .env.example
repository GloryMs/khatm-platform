# =============================================================================
# .env.example — khatm-platform runtime environment contract (KH-0.3.4)
# =============================================================================
#
# This is the COMPLETE contract of every runtime environment variable the platform reads.
# Copy to `.env` (gitignored) for local `docker compose up`, or use it as the input contract
# the `khatm-deploy` repo encrypts with SOPS for real environments (SOPS wiring happens in
# khatm-deploy — out of scope here; see README "Secrets & configuration").
#
# Convention (mirrors application.yml's no-silent-default rule, KH-0.5/KH-0.4/KH-0.6b):
#   REQUIRED outside `local`  -> the app FAILS TO START if unset/blank outside the local profile.
#   local default             -> a documented value the `local` profile supplies so `docker
#                                compose up` works with zero setup. NEVER acceptable elsewhere.
# Values shown as <...> are placeholders — never commit a real secret. `.env` is gitignored.
# =============================================================================

# ---- Spring profile / runtime role -----------------------------------------
# `api` serves REST + publishes events; `worker` consumes Redis Streams + runs no REST (ADR-09).
# Always pair with the deployment profile: local (dev), or a real profile for staging/prod.
# Local/compose: "local,api" / "local,worker".  Real deploy: "api" / "worker" (plus a prod profile).
SPRING_PROFILES_ACTIVE=local,api

# ---- Database (PostgreSQL 16) ----------------------------------------------
# REQUIRED outside local (no real default in non-local profiles). `khatm` matches the compose
# service's POSTGRES_USER.
SPRING_DATASOURCE_URL=jdbc:postgresql://khatm-postgres:5432/khatm
SPRING_DATASOURCE_USERNAME=khatm
SPRING_DATASOURCE_PASSWORD=change-me
# Compose-only: the postgres container's superuser password. Must equal SPRING_DATASOURCE_PASSWORD
# for the app to connect. Local default lives in docker-compose.yml (khatm_local_only).
POSTGRES_PASSWORD=change-me

# ---- Redis 7 (cache + Spring Session + Streams) ----------------------------
SPRING_DATA_REDIS_HOST=khatm-redis
SPRING_DATA_REDIS_PORT=6379

# ---- Issuer signing keys (KH-0.5, spec FS-0.5 §7) --------------------------
# SOFT provider today (PKCS#12 keystore); KMS/PKCS#11 is a config-only swap later (D3).
KHATM_KEYS_KEYSTORE_PATH=/var/khatm/keys/khatm-keys.p12
# REQUIRED outside local. Local default: khatm-local-dev-passphrase-change-me
KHATM_KEYS_PASSPHRASE=change-me

# ---- Claim-code disclosures encryption (KH-0.4, spec FS-0.4 D7) ------------
# AES-256-GCM key for claim_code.disclosures_enc: 32 raw bytes, base64-encoded.
# REQUIRED outside local. Local default: a2hhdG0tbG9jYWwtZGV2LWNsYWltcy1lbmMta2V5ISE=
KHATM_CLAIMS_ENC_KEY=replace-with-32-bytes-base64

# ---- Console auth bootstrap admin (KH-0.6b, spec FS-0.6b D10) --------------
# Auto-provisions the default tenant's first console user (idempotent). REQUIRED outside local
# when no app_user exists yet. Local defaults: admin / khatm-local-dev-admin-change-me
KHATM_BOOTSTRAP_ADMIN_USERNAME=admin
KHATM_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ---- Public base URL (KH-1.3, spec FS-1.3 D2/D7) ---------------------------
# Not a secret. Used to build the public GET /sl/{tenantSlug}/{listCode} status-list URI.
# Always has a default (http://localhost:8080) — set this to the real externally-reachable
# origin in staging/prod so the URI the platform hands out is actually resolvable.
KHATM_PLATFORM_BASE_URL=http://localhost:8080
